import (Heap) from "lib.zen"

Heap h

screen(h.isEmptyInt())
screen(h.sizeInt())

h.pushInt(50)
h.pushInt(20)
h.pushInt(40)
h.pushInt(10)
h.pushInt(30)

screen(h.peekInt())
screen(h.sizeInt())

screen(h.popInt())
screen(h.popInt())
screen(h.popInt())
screen(h.popInt())
screen(h.popInt())

screen(h.isEmptyInt())

h.pushBool(true)
h.pushBool(false)
h.pushBool(true)

screen(h.peekBool())
screen(h.sizeBool())

screen(h.popBool())
screen(h.popBool())
screen(h.popBool())

screen(h.isEmptyBool())

h.pushDouble(5.5)
h.pushDouble(2.2)
h.pushDouble(8.8)
h.pushDouble(1.1)

screen(h.peekDouble())
screen(h.sizeDouble())

screen(h.popDouble())
screen(h.popDouble())
screen(h.popDouble())
screen(h.popDouble())

screen(h.isEmptyDouble())

h.pushLong(500L)
h.pushLong(100L)
h.pushLong(300L)
h.pushLong(200L)

screen(h.peekLong())
screen(h.sizeLong())

screen(h.popLong())
screen(h.popLong())
screen(h.popLong())
screen(h.popLong())

screen(h.isEmptyLong())

h.pushByte(50B)
h.pushByte(10B)
h.pushByte(30B)
h.pushByte(20B)

screen(h.peekByte())
screen(h.sizeByte())

screen(h.popByte())
screen(h.popByte())
screen(h.popByte())
screen(h.popByte())

screen(h.isEmptyByte())

h.pushString("zebra")
h.pushString("apple")
h.pushString("orange")
h.pushString("banana")

screen(h.peekString())
screen(h.sizeString())

screen(h.popString())
screen(h.popString())
screen(h.popString())
screen(h.popString())

screen(h.isEmptyString())
