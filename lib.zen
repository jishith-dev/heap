                smallest = left
            }

            if (right < this.doubles.length && this.doubles[right] < this.doubles[smallest]) {
                smallest = right
            }

            if (smallest == i) {
                break
            }

            double temp = this.doubles[i]
            this.doubles[i] = this.doubles[smallest]
            this.doubles[smallest] = temp

