            bool temp = this.bools[parent]
            this.bools[parent] = this.bools[i]
            this.bools[i] = temp

            i = parent
        }
    }

    popBool() bool {
        bool result = this.bools[0]
        int last = this.bools.length - 1

        if (last == 0) {
            this.bools.removeAt(0)
            return result
        }

        this.bools[0] = this.bools[last]
        this.bools.removeAt(last)

        int i = 0

        while (true) {
            int left = i * 2 + 1
            int right = i * 2 + 2
            int smallest = i

            if (left < this.bools.length && this.bools[left] < this.bools[smallest]) {
                smallest = left
            }

            if (right < this.bools.length && this.bools[right] < this.bools[smallest]) {
                smallest = right
            }

            if (smallest == i) {
                break
            }

            bool temp = this.bools[i]
            this.bools[i] = this.bools[smallest]
            this.bools[smallest] = temp

            i = smallest
        }

        return result
    }

    peekBool() bool {
        return this.bools[0]
    }

    sizeBool() int {
        return this.bools.length
    }

    isEmptyBool() bool {
        return this.bools.length == 0
    }

