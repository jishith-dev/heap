struct Heap {
    List<int> ints
    List<bool> bools
    List<double> doubles
    List<long> longs
    List<byte> bytes
    List<string> strings

    pushInt(int v) void {
        this.ints.push(v)

        int i = this.ints.length - 1

        while (i > 0) {
            int parent = (i - 1) / 2

            if (this.ints[parent] <= this.ints[i]) {
                break
            }

            int temp = this.ints[parent]
            this.ints[parent] = this.ints[i]
            this.ints[i] = temp

            i = parent
        }
    }

    popInt() int {
        int result = this.ints[0]
        int last = this.ints.length - 1

        if (last == 0) {
            this.ints.removeAt(0)
            return result
        }

        this.ints[0] = this.ints[last]
        this.ints.removeAt(last)

        int i = 0

        while (true) {
            int left = i * 2 + 1
            int right = i * 2 + 2
            int smallest = i

            if (left < this.ints.length && this.ints[left] < this.ints[smallest]) {
                smallest = left
            }

            if (right < this.ints.length && this.ints[right] < this.ints[smallest]) {
                smallest = right
            }

            if (smallest == i) {
                break
            }

            int temp = this.ints[i]
            this.ints[i] = this.ints[smallest]
            this.ints[smallest] = temp

            i = smallest
        }

        return result
    }

    peekInt() int {
        return this.ints[0]
    }

    sizeInt() int {
        return this.ints.length
    }

    isEmptyInt() bool {
        return this.ints.length == 0
    }

